+export const bossEye = { fn: null };
+
+// The Spawn panel's chosen revenant art: `lookup(id)` answers the art kept on the record, or null for the game's own draw
+// (systems/revenant/revenantArts.js drawArt, ARTS_EDITS)
+export const revenantArt = { lookup: null };
+
+// The Mounts panel's chosen steed stats: `of(item)` answers the born stats it chose for a horse or the dragon ({ speed,
+// stamina, endurance, strength }), or null for the game's own seed (systems/steedCare.js horseBornStats, STEED_EDITS)
+export const steedBorn = { of: null };
