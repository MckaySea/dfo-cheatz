 .dfo-sellopts summary { cursor: pointer; color: var(--dfo-dim); font-size: 11px; }
 .dfo-sellopts[open] summary { color: var(--dfo-text); }
 
+/* loot filter */
+.dfo-metals { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; }
+.dfo-root button.dfo-metal { all: unset; cursor: pointer; display: flex; align-items: center; gap: 6px; padding: 5px 8px; border-radius: 6px;
+  font-weight: 600; font-size: 11.5px; border: 1px solid var(--dfo-line);
+  color: hsl(calc(30 + var(--tier) * 20), calc(15% + var(--tier) * 55%), calc(62% + var(--tier) * 10%));
+  background: hsla(calc(30 + var(--tier) * 20), 60%, 50%, calc(0.05 + var(--tier) * 0.10));
+  transition: background 0.12s, color 0.12s, border-color 0.12s, transform 0.08s; }
+.dfo-root button.dfo-metal:hover { border-color: var(--dfo-accent); }
+.dfo-root button.dfo-metal:active { transform: scale(0.96); }
+.dfo-metal .mk { width: 14px; height: 14px; border-radius: 4px; display: inline-flex; align-items: center; justify-content: center;
+  font-size: 10px; background: rgba(111,207,138,0.22); color: var(--dfo-good); }
+.dfo-root button.dfo-metal.off { color: var(--dfo-dim); background: rgba(0,0,0,0.25); text-decoration: line-through; text-decoration-color: rgba(228,106,106,0.55); }
+.dfo-metal.off .mk { background: rgba(228,106,106,0.20); color: var(--dfo-bad); }
+.dfo-root button.dfo-preset.on { border-color: var(--dfo-accent); color: var(--dfo-accent); }
+.dfo-root button.dfo-switch { all: unset; cursor: pointer; min-width: 34px; text-align: center; padding: 4px 10px; border-radius: 999px;
+  font-weight: 700; font-size: 11px; background: rgba(0,0,0,0.35); color: var(--dfo-dim); border: 1px solid var(--dfo-line); transition: all 0.12s; }
+.dfo-root button.dfo-switch.on { background: rgba(111,207,138,0.18); color: var(--dfo-good); border-color: rgba(111,207,138,0.45); }
+.dfo-lf.dfo-lf-off .dfo-metals, .dfo-lf.dfo-lf-off .dfo-lfopts { opacity: 0.45; }
+.dfo-lfopts { display: flex; flex-direction: column; gap: 6px; font-size: 11px; }
+.dfo-lfcheck { display: inline-flex; gap: 6px; align-items: center; cursor: pointer; }
+.dfo-lflive { background: var(--dfo-bg2); border: 1px solid var(--dfo-line); border-radius: 6px; padding: 6px 8px; min-height: 22px; }
+.dfo-lflive .dfo-note { margin: 0; }
+.dfo-lfcount b { color: var(--dfo-accent); font-size: 14px; }
+.dfo-lfnames { display: flex; flex-wrap: wrap; gap: 3px; margin-top: 4px; }
+.dfo-lfnames span { padding: 1px 6px; border-radius: 4px; background: rgba(0,0,0,0.3); font-size: 11px; color: var(--dfo-dim); }
+
 /* world map notes */
 .dfo-root input.dfo-noteedit { font-style: italic; }
