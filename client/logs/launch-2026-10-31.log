@@ -85,8 +89,43 @@ export function bootOverlay() {
   document.addEventListener('pointerlockchange', () => { if (document.pointerLockElement && wm.isEdit()) setEdit(false); });
   addEventListener('dfo:play', () => { if (wm.isEdit()) setEdit(false); });
 
-  // The game's free cursor (its FreeMouse / ActivateCursor toggle) - read, never set: the player's own key decides
-  const loop = () => { wm.setFree(cursorActive() && !document.pointerLockElement); wm.tick(performance.now()); };
+  // THE INVENTORY KEY: the Gear panel, like the pack but the overlay's. The key is the game's own Inventory binding (a
+  // rebind moves it too). The mouse is freed by a HOLD of the overlay's own (pointerLock.js holdCursor - the hold the
+  // Basket and the card tables take), never the player's Y flag, and handed back when the panel goes - by this key, its
+  // ✕ or its dock button; the look is asked back only if the game had it when the panel came up. Left to the game: a
+  // typed field, Shift+I, and any game window or enhanced overlay already up (its own I closes it).
+  let gearHold = null, gearLock = null;
+  const gearAway = () => {
+    const last = gearHold?.();
+    gearHold = null;
+    const el = gearLock;
+    gearLock = null;
+    if (last && el?.isConnected && !cursorActive()) requestLook(el);
+  };
+  const gearToggle = () => {
+    if (wm.isSummoned('gear')) { wm.summon('gear', false); gearAway(); return; }
+    gearLock = document.pointerLockElement;
+    if (!wm.summon('gear', true)) { gearLock = null; return; }
+    gearHold = holdCursor();
+  };
+  addEventListener('keydown', (e) => {
+    if (e.shiftKey || isTextEntryTarget(e.target)) return;
+    let acts = [];
+    try { acts = eventActions(e); } catch { acts = []; }
+    if (!acts.includes('Inventory')) return;
+    if (!wm.isSummoned('gear') && (hostPaused() === true || overlayOpen())) return;
+    e.preventDefault();
+    e.stopImmediatePropagation();
+    if (!e.repeat) gearToggle();
+  }, true);
+
+  // The game's free cursor (its FreeMouse / ActivateCursor toggle) - read, never set: the player's own key decides. The
+  // Gear's hold reads the same: its panel and every pinned one take the mouse while it is up.
+  const loop = () => {
+    if (gearHold && !wm.isSummoned('gear')) gearAway();   // put away by its ✕ or the dock
+    wm.setFree((cursorActive() || cursorHeld()) && !document.pointerLockElement);
+    wm.tick(performance.now());
+  };
   setInterval(loop, 100);
   console.info(`[overlay] DFO overlay ready - press ${toggleKey()}`);
 }
