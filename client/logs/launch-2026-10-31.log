@@ -100,6 +100,38 @@ export const __dfoTradeDoor = Object.freeze({
   sell: () => { if (!host || !selling()) return false; modeAction(); return true; },
 });`;
 
+// systems/worldHover.js + systems/quickLoot.js: the loot filter (lootHook.js). Exact lines of the game's own, swapped
+// for the same line with the hook in it. hoverItems is the ONE walk the plaque's rows and the take's row -> item both
+// read, so filtering there keeps the lit row and the item moved the same piece; a house cupboard's glance (a preview,
+// never a take) reads the whole list. Take everything leaves what the plaque does not show. Nothing new is sent: a
+// filtered piece is simply not taken.
+const LOOT_READS = "{ material: __dfoMat, rank: __dfoRank, ammo: __dfoAmmo, name: (it) => __dfoName(it).name }";
+const HOVER_IMPORT = "import * as __dfoLoot from '../devtools/overlay/lootHook.js'; import { materialName as __dfoMat, itemNameParts as __dfoName } from './item/itemInfo.js'; import { rarityRank as __dfoRank } from './loot/lootRarity.js'; import { isAmmunition as __dfoAmmo } from './item/itemTemplates.js';";
+const HOVER_EDITS = [
+  ['the rows', 'export const hoverItems = (items) => (items ?? []).filter(Boolean);', 'export const hoverItems = (items) => __dfoLoot.keep((items ?? []).filter(Boolean), __dfoLootReads);'],
+  ['the lines', 'export function hoverLines(items, max = HOVER_MAX) {', 'export function hoverLines(items, max = HOVER_MAX, __dfoAll = false) {'],
+  ['the line walk', '  const rows = hoverItems(items).map((it) => ({', '  const rows = (__dfoAll ? (items ?? []).filter(Boolean) : hoverItems(items)).map((it) => ({'],
+  ['the count', '  return { shown, rest, empty: rows.length === 0 };', '  const hidden = __dfoAll ? 0 : __dfoLoot.hiddenCount(items, __dfoLootReads); return { shown, rest, empty: rows.length === 0 && !hidden, hidden };'],
+  ['the glance', '  const { shown, rest, empty } = hoverLines(held, Infinity);', '  const { shown, rest, empty } = hoverLines(held, Infinity, true);'],
+  ['the pile', '    const { shown, rest, empty } = hoverLines(contents?.(key) ?? null, Infinity);', '    const { shown, rest, empty, hidden } = hoverLines(contents?.(key) ?? null, Infinity);'],
+  ['the pile frame', "    return frame(key, 'items', named.title, named.subs ?? [], shown, rest, empty);", "    return frame(key, 'items', named.title, __dfoLoot.subs(named.subs ?? [], hidden, shown.length), shown, rest, empty);"],
+];
+const HOVER_FOOT = `const __dfoLootReads = ${LOOT_READS};`;
+const QL_IMPORT = "import * as __dfoLoot from '../devtools/overlay/lootHook.js'; import { materialName as __dfoMat, itemNameParts as __dfoName } from './item/itemInfo.js';";
+const QL_EDITS = [
+  ['the take-all', '  if (isJunk(item)) return true;', '  if (isJunk(item) || __dfoLoot.leaves(item, __dfoLootReads)) return true;'],
+];
+const QL_FOOT = "const __dfoLootReads = { material: __dfoMat, rank: rarityRank, ammo: isAmmunition, name: (it) => __dfoName(it).name };";
+const editAll = (ctx, code, edits, file) => {
+  let out = code;
+  for (const [what, from, to] of edits) {
+    const n = out.split(from).length - 1;
+    if (n !== 1) ctx.error(`[dfo-overlay] the loot filter's anchor for ${what} is ${n ? 'not unique' : 'gone'} in ${file}`);
+    out = out.replace(from, to);
+  }
+  return out;
+};
+
 const fileIs = (id, tail) => id.split('?')[0].replace(/\\/g, '/').endsWith(tail);
 
 function overlayHooks() {
@@ -128,6 +160,14 @@ function overlayHooks() {
         if (!/import \{[^}]*\blocalListAccepts\b[^}]*\}/.test(code)) this.error('[dfo-overlay] the Sell helper\'s door needs localListAccepts imported in src/ui/enhanced/enhancedTrade.js');
         return { code: `${code}\n${TRADE_FOOT}\n`, map: null };
       }
+      if (fileIs(id, '/src/systems/worldHover.js')) {
+        return { code: `${HOVER_IMPORT} ${editAll(this, code, HOVER_EDITS, 'src/systems/worldHover.js')}\n${HOVER_FOOT}\n`, map: null };
+      }
+      if (fileIs(id, '/src/systems/quickLoot.js')) {
+        for (const need of [/import \{[^}]*\brarityRank\b[^}]*\} from '\.\/loot\/lootRarity\.js'/, /import \{[^}]*\bisAmmunition\b[^}]*\} from '\.\/item\/itemTemplates\.js'/])
+          if (!need.test(code)) this.error(`[dfo-overlay] the loot filter needs ${need} in src/systems/quickLoot.js`);
+        return { code: `${QL_IMPORT} ${editAll(this, code, QL_EDITS, 'src/systems/quickLoot.js')}\n${QL_FOOT}\n`, map: null };
+      }
       return null;
     },
   };
