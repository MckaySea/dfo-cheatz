diff --git a/src/devtools/overlay/index.js b/src/devtools/overlay/index.js
index ad6fd17a2e..a350bb8917 100644
--- a/src/devtools/overlay/index.js
+++ b/src/devtools/overlay/index.js
@@ -15,6 +15,9 @@ import { lootPanel } from './panels/loot.js';
 import { buffsPanel } from './panels/buffs.js';
 import { nodesPanel } from './panels/nodes.js';
 import { townMapPanel } from './panels/townmap.js';
+import { travelPanel } from './panels/travel.js';
+import { sessionPanel, installSessionRecorder } from './panels/session.js';
+import { skillsPanel } from './panels/skills.js';
 import { installGearKeys } from './panels/gearLaw.js';
 import { h, overlayToggleKey as toggleKey } from './ui.js';
 
@@ -44,9 +47,18 @@ export function bootOverlay() {
     t.dfoKey?.(e);
   }, true);
 
+  // A press on the overlay is the overlay's. The game swings and acts from WINDOW mousedown/mouseup (world.js: Mouse1 the
+  // swing, Mouse0 a bound key), so a right-click on a panel swung the weapon. The press stops at the root; its release
+  // stops too, but only for a button whose press was ours - a press on the game released over a panel still lets go.
+  const ours = new Set();
+  root.addEventListener('mousedown', (e) => { if (e.target.closest?.('.dfo-panel, .dfo-dock')) { ours.add(e.button); e.stopPropagation(); } });
+  addEventListener('mouseup', (e) => { if (ours.delete(e.button)) e.stopImmediatePropagation(); }, true);
+  root.addEventListener('contextmenu', (e) => { if (e.target.closest?.('.dfo-panel')) e.stopPropagation(); });
+
   installCombatRecorder();   // the log fills from the first blow, panel open or not
+  installSessionRecorder();  // the session counts from the boot, panel open or not
   installGearKeys();         // gear hotkeys work with the panel closed; installed before the toggle key so a bind in progress takes every key
-  for (const make of [gearPanel, combatPanel, spellsPanel, lootPanel, buffsPanel, nodesPanel, townMapPanel]) {
+  for (const make of [gearPanel, combatPanel, spellsPanel, lootPanel, buffsPanel, nodesPanel, townMapPanel, travelPanel, sessionPanel, skillsPanel]) {
     try { wm.add(make()); } catch (e) { console.warn('[overlay] a panel failed to mount', e); }
   }
 
@@ -59,8 +71,10 @@ export function bootOverlay() {
     e.stopPropagation();
     setEdit(!wm.isEdit());
   }, true);
-  // Clicking back into the game (it takes the pointer lock again) ends EDIT mode.
+  // Clicking back into the game (it takes the pointer lock again) ends EDIT mode - and so does a panel that handed the
+  // game something to do (the travel panel's journey: the Overworld rises with its own cursor)
   document.addEventListener('pointerlockchange', () => { if (document.pointerLockElement && wm.isEdit()) setEdit(false); });
+  addEventListener('dfo:play', () => { if (wm.isEdit()) setEdit(false); });
 
   const loop = () => { wm.tick(performance.now()); };
   setInterval(loop, 100);
diff --git a/src/devtools/overlay/style.js b/src/devtools/overlay/style.js
index 31b3cfa727..aa970780ad 100644
--- a/src/devtools/overlay/style.js
+++ b/src/devtools/overlay/style.js
@@ -195,4 +195,67 @@ export const OVERLAY_CSS = `
 .dfo-wrow .nm:hover { color: var(--dfo-accent); }
 .dfo-wrow .x { cursor: pointer; color: var(--dfo-dim); }
 .dfo-wrow .x:hover { color: var(--dfo-bad); }
+
+/* a live panel in play: it keeps the mouse whenever the game frees the cursor */
+.dfo-panel.dfo-live { box-shadow: 0 6px 20px rgba(0,0,0,0.4); }
+
+/* travel */
+.dfo-tbar { display: inline-flex; gap: 6px; align-items: center; flex: none; }
+.dfo-root button.dfo-owbtn { padding: 2px 9px; white-space: nowrap; }
+.dfo-root button.dfo-owbtn.on { background: rgba(224,178,90,0.18); color: var(--dfo-accent); border-color: rgba(224,178,90,0.5); }
+.dfo-tfind { padding: 5px 8px; border-bottom: 1px solid var(--dfo-line); }
+.dfo-root input.dfo-tsearch { width: 100%; }
+.dfo-sresults { position: absolute; z-index: 4; left: 8px; right: 8px; top: 4px; padding: 3px; border-radius: 8px; background: rgba(22,24,29,0.97);
+  border: 1px solid var(--dfo-line); box-shadow: 0 8px 22px rgba(0,0,0,0.55); }
+.dfo-sres { display: flex; justify-content: space-between; gap: 10px; padding: 4px 8px; border-radius: 5px; cursor: pointer; }
+.dfo-sres:hover { background: rgba(224,178,90,0.15); }
+.dfo-sres span:first-child { font-weight: 600; }
+.dfo-tcard { gap: 8px; }
+.dfo-root .dfo-tcard button.dfo-btn { padding: 4px 10px; }
+.dfo-root .dfo-tcard button.dfo-btn.on { color: #f1c453; }
+.dfo-root .dfo-tcard button.go { padding: 5px 14px; font-size: 12.5px; }
+
+/* session */
+.dfo-shead { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 8px; }
+.dfo-clock { font-size: 24px; font-weight: 800; letter-spacing: 0.01em; }
+.dfo-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(138px, 1fr)); gap: 6px; }
+.dfo-card { padding: 7px 9px; border-radius: 8px; background: rgba(255,255,255,0.035); border: 1px solid var(--dfo-line); min-width: 0; }
+.dfo-card .lb { color: var(--dfo-dim); font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.07em; }
+.dfo-card .big { font-size: 19px; font-weight: 800; margin: 1px 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.dfo-card .big.good { color: var(--dfo-good); } .dfo-card .big.bad { color: var(--dfo-bad); }
+.dfo-card .sb { color: var(--dfo-dim); font-size: 10.5px; min-height: 14px; overflow-wrap: anywhere; }
+.dfo-spark { display: block; width: 100%; height: 74px; border-radius: 7px; background: rgba(0,0,0,0.25); border: 1px solid var(--dfo-line); }
+.dfo-spark .ln { fill: none; stroke: var(--dfo-accent); stroke-width: 1.8; vector-effect: non-scaling-stroke; }
+.dfo-spark .area { fill: rgba(224,178,90,0.14); stroke: none; }
+.dfo-spark .zero { stroke: rgba(255,255,255,0.18); stroke-dasharray: 3 3; vector-effect: non-scaling-stroke; }
+.dfo-chips { display: flex; flex-wrap: wrap; gap: 4px; }
+.dfo-chip.up { color: var(--dfo-good); background: rgba(111,207,138,0.1); padding: 1px 8px; }
+
+/* skills */
+.dfo-lvcard { padding: 9px 11px; border-radius: 9px; background: rgba(0,0,0,0.25); border: 1px solid var(--dfo-line); }
+.dfo-lvcard .top { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; margin-bottom: 5px; }
+.dfo-lvcard .lv { font-size: 20px; }
+.dfo-pill { padding: 1px 8px; border-radius: 9px; font-size: 11px; font-weight: 700; }
+.dfo-pill.go { color: #1b1407; background: var(--dfo-accent); }
+.dfo-bar.big { height: 9px; border-radius: 5px; }
+.dfo-bar.ren { position: relative; display: flex; }
+.dfo-bar.ren > i { background: #8fb6ff; }
+.dfo-bar.ren > i.ghost { background: rgba(143,182,255,0.35); }
+.dfo-skstatus { margin-top: 8px; padding: 6px 9px; border-radius: 6px; background: rgba(255,255,255,0.035); }
+.dfo-sklist .dfo-h:first-child { margin-top: 4px; }
+.dfo-sk { display: grid; grid-template-columns: minmax(0, 1.6fr) 40px minmax(40px, 1fr) 54px; gap: 7px; align-items: center; padding: 3px 4px; border-radius: 5px; }
+.dfo-sk:hover { background: var(--dfo-bg2); }
+.dfo-sk .nm { display: flex; gap: 6px; align-items: center; min-width: 0; white-space: nowrap; overflow: hidden; }
+.dfo-sk .nm > span:first-child { overflow: hidden; text-overflow: ellipsis; }
+.dfo-sk .val { text-align: right; font-weight: 700; white-space: nowrap; }
+.dfo-sk .val .gain { margin-left: 3px; font-size: 10px; color: var(--dfo-good); }
+.dfo-sk .pc { text-align: right; color: var(--dfo-dim); font-size: 11px; white-space: nowrap; }
+.dfo-sk.near .dfo-bar > i { background: #f0c96f; }
+.dfo-sk.ready .dfo-bar > i { background: var(--dfo-good); }
+.dfo-sk.ready .pc { color: var(--dfo-good); font-weight: 700; }
+.dfo-sk.held .dfo-bar > i { background: rgba(255,255,255,0.2); }
+.dfo-role { flex: none; padding: 0 5px; border-radius: 4px; font-size: 9.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em;
+  color: var(--dfo-accent); background: rgba(224,178,90,0.12); }
+.dfo-role.dropped { color: var(--dfo-dim); background: rgba(255,255,255,0.05); text-decoration: line-through; }
+.dfo-role.best { color: #8fb6ff; background: rgba(143,182,255,0.12); }
 `;
diff --git a/src/devtools/overlay/vite.overlay.config.js b/src/devtools/overlay/vite.overlay.config.js
index 31d3370c77..c90ff28432 100644
--- a/src/devtools/overlay/vite.overlay.config.js
+++ b/src/devtools/overlay/vite.overlay.config.js
@@ -13,8 +13,16 @@ import base from '../../../vite.config.js';
 // main.js: boot the overlay as the entry module starts
 const MAIN_HOOK = "import('./devtools/overlay/index.js').then((m) => m.bootOverlay()).catch((e) => console.warn('[overlay]', e));";
 
-// world.js: the read-only closures the overlay's panels read, handed over as bootWorld starts. Each is read when a
-// panel asks (tap.js guards every call: a name declared further down bootWorld answers null until the boot reaches it)
+// world.js: the closures the overlay's panels read, handed over as bootWorld starts. Each is read when a panel asks
+// (tap.js guards every call: a name declared further down bootWorld answers null until the boot reaches it).
+// Two are DOORS, not reads - the travel panel's, and each is a door the game already has, with its own refusals:
+//   overworld  the TravelView action's own arm (world.js travelViewKey, under the key's `overlayActive` gate)
+//   journey    the Overworld's own click on a place or a spot (world.js onTravelViewPick / beginAcceleratedTravel's
+//              enhanced arm): travelViewAllowed, travelViewCanGo (foes near, a wall, another's boat or wagon), then
+//              travelViewRouteTo / travelViewWalkTo - Travel Options walks it, the clock runs, nothing is skipped. Where
+//              the Overworld owns no journeys (Travel Options off, the classic skin) it is the journal's door instead:
+//              the travel map opened on the place (toggleTravelMap - every refusal the V key meets), Begin left to you.
+// No `//` inside the hook: it is laid on one line.
 const WORLD_ANCHOR = /export async function bootWorld\s*\([^)]*\)\s*\{/;
 const WORLD_HOOK = `import('../devtools/overlay/tap.js').then((m) => m.tapWorld({
   pixel: () => playerTravelPixel(),
@@ -27,6 +35,23 @@ const WORLD_HOOK = `import('../devtools/overlay/tap.js').then((m) => m.tapWorld(
   yaw: () => cam.yaw,
   townBag: () => travelTown().town ?? null,
   locOrigin: (x, y) => built.get(\`\${x},\${y}\`)?.locOrigin ?? null,
+  bay: () => ({ maps, mapDict, woods, roads: terrainGen?.roads?.() ?? null }),
+  party: () => partyMarkers(),
+  renown: () => ({ level: renownNow, xp: renownXp, pending: renownTracker?.pending?.() ?? 0 }),
+  overworldUp: () => travelView?.state === 'up' || travelView?.state === 'rising',
+  overworld: () => { if (townTalk.overlayActive) return false; travelViewKey(); return true; },
+  journey: (x, y, o = {}) => {
+    if (townTalk.overlayActive) return 'busy';
+    if (!tvRoutesJourneys()) return toggleTravelMap(o.site ?? null) ? 'map' : 'refused';
+    const why = travelViewAllowed();
+    if (!why.ok) { if (why.why) tvSay(why.why); return why.why ? 'no:' + why.why : 'refused'; }
+    if (!travelViewCanGo()) return 'refused';
+    if (!o.spot) { const s = tvPlaceSummary(x, y, false); return s && travelViewRouteTo(s, { roads: tvMapForcesRoads() }) ? 'ok' : 'refused'; }
+    if (travelOptions?.settings?.targetCoordsAllowed === false) { tvSay(TRAVEL_VIEW_TEXT.placesOnly); return 'no:' + TRAVEL_VIEW_TEXT.placesOnly; }
+    const w = mapPixelToWorldCoords(x, y), at = tvSceneOf(w.x + 16384, w.z + 16384, 0);
+    if (tvWater(x, y) || at[1] <= tvSeaY() + TV_SEA_EPS_M) { tvSay(TRAVEL_VIEW_TEXT.water); return 'no:' + TRAVEL_VIEW_TEXT.water; }
+    return travelViewWalkTo(at, { x, y }, { roads: tvMapForcesRoads() }) ? 'ok' : 'refused';
+  },
 })).catch(() => {});`.replace(/\n\s*/g, ' ');
 
 const fileIs = (id, tail) => id.split('?')[0].replace(/\\/g, '/').endsWith(tail);
