+const TRADE_FOOT = `
+function __dfoSellable() {
+  const equipped = deps.isEquipped ?? (() => false);
+  const held = remoteItems();
+  return (deps.packItems?.() ?? []).filter((it) => !equipped(it) && !held.includes(it) && localListAccepts(mode, it, { accepts: deps.accepts, enchanted: deps.enchanted }));
+}
+export const __dfoTradeDoor = Object.freeze({
+  up: () => !!host && selling(),
