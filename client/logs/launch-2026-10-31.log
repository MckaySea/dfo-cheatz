 //   Insert (default)   toggle EDIT mode: frees the cursor, shows the dock and every open panel, makes them clickable.
 //   In PLAY mode       pinned panels stay up, click-through, at their own opacity (Alt+wheel over a panel in EDIT).
 //   Free mouse (Y)     the game's own free-cursor toggle: pinned panels take clicks while it is up.
+//   Inventory (I)      the Gear panel instead of the game's pack: up with the mouse freed, away with the look back.
+//                      Shift+I (or I while a game window is up) is still the game's own.
 //
 // The key is kept in localStorage 'dfoOverlay.key' (a KeyboardEvent.code, e.g. 'Insert', 'F7', 'Backquote').
 
 import { OVERLAY_CSS } from './style.js';
 import { createWindowManager } from './wm.js';
-import { cursorActive } from '../../player/pointerLock.js';
+import { cursorActive, cursorHeld, holdCursor, requestLook } from '../../player/pointerLock.js';
