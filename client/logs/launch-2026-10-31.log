index 65eceac7b1..10d7b845b1 100644
--- a/src/devtools/overlay/style.js
+++ b/src/devtools/overlay/style.js
@@ -262,4 +262,35 @@ export const OVERLAY_CSS = `
   color: var(--dfo-accent); background: rgba(224,178,90,0.12); }
 .dfo-role.dropped { color: var(--dfo-dim); background: rgba(255,255,255,0.05); text-decoration: line-through; }
 .dfo-role.best { color: #8fb6ff; background: rgba(143,182,255,0.12); }
+.dfo-packsearch .dfo-packcount { color: #9c937d; font-size: 12px; white-space: nowrap; }
+
+/* pack & shop, loot log: a row of one piece */
+.dfo-warn { color: #f0c96f; }
+.dfo-bar.heavy > i { background: #f0c96f; }
+.dfo-prow { display: grid; grid-template-columns: 8px minmax(0, 1fr) auto 52px; gap: 7px; align-items: center; padding: 2px 4px; border-radius: 5px; }
+.dfo-prow:hover { background: var(--dfo-bg2); }
+.dfo-prow .dot { width: 8px; height: 8px; border-radius: 4px; }
+.dfo-prow .nm { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.dfo-prow .gold { color: var(--dfo-accent); text-align: right; }
+
+/* alerts: the stack over the game, and the settings rows */
+.dfo-alerts { position: absolute; top: 56px; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; gap: 6px;
+  align-items: center; pointer-events: none; }
+.dfo-alert { min-width: 240px; max-width: 460px; padding: 7px 14px 8px; border-radius: 9px; background: var(--dfo-bg); border: 1px solid rgba(224,178,90,0.45);
+  border-left: 4px solid var(--dfo-accent); box-shadow: 0 6px 20px rgba(0,0,0,0.4); font-weight: 600; transition: opacity .4s, transform .4s;
+  animation: dfo-alert-in .25s ease-out; }
+.dfo-alert .lb { color: var(--dfo-accent); font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.07em; }
+.dfo-alert.bad { border-color: rgba(228,106,106,0.5); border-left-color: var(--dfo-bad); }
+.dfo-alert.bad .lb { color: var(--dfo-bad); }
+.dfo-alert.out { opacity: 0; transform: translateY(-6px); }
+@keyframes dfo-alert-in { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: none; } }
+.dfo-arow { display: grid; grid-template-columns: minmax(0, 1fr) auto auto auto; gap: 6px; align-items: center; padding: 3px 0; }
+.dfo-arow label:first-child { display: flex; gap: 6px; align-items: center; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.dfo-root .dfo-arow button.dfo-btn { padding: 2px 7px; }
+.dfo-root .dfo-arow button.dfo-btn:not(.on):first-of-type { opacity: 0.55; }
+
+/* world map notes */
+.dfo-root input.dfo-noteedit { font-style: italic; }
+.dfo-root .dfo-tcard button.dfo-btn.sure { color: var(--dfo-bad); border-color: var(--dfo-bad); }
+.dfo-wrow .x.dfo-bad { color: var(--dfo-bad); font-weight: 700; }
 `;
