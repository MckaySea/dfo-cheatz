+.dfo-layrow .dfo-del { font-size: 14px; }
+.dfo-root textarea.dfo-layimport { width: 100%; box-sizing: border-box; resize: vertical; font: 11px/1.4 ui-monospace, Consolas, monospace;
+  background: rgba(0,0,0,0.35); color: var(--dfo-text); border: 1px solid var(--dfo-line); border-radius: 6px; padding: 6px 8px; }
 .dfo-detail { min-height: 104px; padding: 8px 10px; border-radius: 9px; background: rgba(0,0,0,0.25); border: 1px solid var(--dfo-line); }
 .dfo-dtop { display: flex; gap: 10px; align-items: center; margin-bottom: 6px; }
 .dfo-dtop .dfo-tile { width: 58px; height: 58px; cursor: default; }
