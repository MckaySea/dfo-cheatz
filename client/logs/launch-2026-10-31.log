@@ -195,4 +195,67 @@ export const OVERLAY_CSS = `
 .dfo-wrow .nm:hover { color: var(--dfo-accent); }
 .dfo-wrow .x { cursor: pointer; color: var(--dfo-dim); }
 .dfo-wrow .x:hover { color: var(--dfo-bad); }
+
+/* a live panel in play: it keeps the mouse whenever the game frees the cursor */
+.dfo-panel.dfo-live { box-shadow: 0 6px 20px rgba(0,0,0,0.4); }
+
+/* travel */
+.dfo-tbar { display: inline-flex; gap: 6px; align-items: center; flex: none; }
+.dfo-root button.dfo-owbtn { padding: 2px 9px; white-space: nowrap; }
+.dfo-root button.dfo-owbtn.on { background: rgba(224,178,90,0.18); color: var(--dfo-accent); border-color: rgba(224,178,90,0.5); }
+.dfo-tfind { padding: 5px 8px; border-bottom: 1px solid var(--dfo-line); }
+.dfo-root input.dfo-tsearch { width: 100%; }
+.dfo-sresults { position: absolute; z-index: 4; left: 8px; right: 8px; top: 4px; padding: 3px; border-radius: 8px; background: rgba(22,24,29,0.97);
+  border: 1px solid var(--dfo-line); box-shadow: 0 8px 22px rgba(0,0,0,0.55); }
+.dfo-sres { display: flex; justify-content: space-between; gap: 10px; padding: 4px 8px; border-radius: 5px; cursor: pointer; }
+.dfo-sres:hover { background: rgba(224,178,90,0.15); }
+.dfo-sres span:first-child { font-weight: 600; }
+.dfo-tcard { gap: 8px; }
+.dfo-root .dfo-tcard button.dfo-btn { padding: 4px 10px; }
+.dfo-root .dfo-tcard button.dfo-btn.on { color: #f1c453; }
+.dfo-root .dfo-tcard button.go { padding: 5px 14px; font-size: 12.5px; }
+
+/* session */
+.dfo-shead { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 8px; }
+.dfo-clock { font-size: 24px; font-weight: 800; letter-spacing: 0.01em; }
+.dfo-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(138px, 1fr)); gap: 6px; }
+.dfo-card { padding: 7px 9px; border-radius: 8px; background: rgba(255,255,255,0.035); border: 1px solid var(--dfo-line); min-width: 0; }
+.dfo-card .lb { color: var(--dfo-dim); font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.07em; }
+.dfo-card .big { font-size: 19px; font-weight: 800; margin: 1px 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.dfo-card .big.good { color: var(--dfo-good); } .dfo-card .big.bad { color: var(--dfo-bad); }
+.dfo-card .sb { color: var(--dfo-dim); font-size: 10.5px; min-height: 14px; overflow-wrap: anywhere; }
+.dfo-spark { display: block; width: 100%; height: 74px; border-radius: 7px; background: rgba(0,0,0,0.25); border: 1px solid var(--dfo-line); }
+.dfo-spark .ln { fill: none; stroke: var(--dfo-accent); stroke-width: 1.8; vector-effect: non-scaling-stroke; }
+.dfo-spark .area { fill: rgba(224,178,90,0.14); stroke: none; }
+.dfo-spark .zero { stroke: rgba(255,255,255,0.18); stroke-dasharray: 3 3; vector-effect: non-scaling-stroke; }
+.dfo-chips { display: flex; flex-wrap: wrap; gap: 4px; }
+.dfo-chip.up { color: var(--dfo-good); background: rgba(111,207,138,0.1); padding: 1px 8px; }
+
+/* skills */
+.dfo-lvcard { padding: 9px 11px; border-radius: 9px; background: rgba(0,0,0,0.25); border: 1px solid var(--dfo-line); }
+.dfo-lvcard .top { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; margin-bottom: 5px; }
+.dfo-lvcard .lv { font-size: 20px; }
+.dfo-pill { padding: 1px 8px; border-radius: 9px; font-size: 11px; font-weight: 700; }
+.dfo-pill.go { color: #1b1407; background: var(--dfo-accent); }
+.dfo-bar.big { height: 9px; border-radius: 5px; }
+.dfo-bar.ren { position: relative; display: flex; }
+.dfo-bar.ren > i { background: #8fb6ff; }
+.dfo-bar.ren > i.ghost { background: rgba(143,182,255,0.35); }
+.dfo-skstatus { margin-top: 8px; padding: 6px 9px; border-radius: 6px; background: rgba(255,255,255,0.035); }
+.dfo-sklist .dfo-h:first-child { margin-top: 4px; }
+.dfo-sk { display: grid; grid-template-columns: minmax(0, 1fr) 46px minmax(60px, 0.8fr) 74px; gap: 8px; align-items: center; padding: 3px 4px; border-radius: 5px; }
+.dfo-sk:hover { background: var(--dfo-bg2); }
+.dfo-sk .nm { display: flex; gap: 6px; align-items: center; min-width: 0; white-space: nowrap; overflow: hidden; }
+.dfo-sk .nm > span:first-child { overflow: hidden; text-overflow: ellipsis; }
+.dfo-sk .val { text-align: right; font-weight: 700; white-space: nowrap; }
+.dfo-sk .val .gain { margin-left: 3px; font-size: 10px; color: var(--dfo-good); }
+.dfo-sk .pc { text-align: right; color: var(--dfo-dim); font-size: 11px; white-space: nowrap; }
+.dfo-sk.near .dfo-bar > i { background: #f0c96f; }
+.dfo-sk.ready .dfo-bar > i { background: var(--dfo-good); }
+.dfo-sk.ready .pc { color: var(--dfo-good); font-weight: 700; }
+.dfo-sk.held .dfo-bar > i { background: rgba(255,255,255,0.2); }
+.dfo-role { flex: none; padding: 0 5px; border-radius: 4px; font-size: 9.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em;
+  color: var(--dfo-accent); background: rgba(224,178,90,0.12); }
+.dfo-role.dropped { color: var(--dfo-dim); background: rgba(255,255,255,0.05); text-decoration: line-through; }
+.dfo-role.best { color: #8fb6ff; background: rgba(143,182,255,0.12); }
 `;
