   townBag: () => travelTown().town ?? null,
   locOrigin: (x, y) => built.get(\`\${x},\${y}\`)?.locOrigin ?? null,
+  bay: () => ({ maps, mapDict, woods, roads: terrainGen?.roads?.() ?? null }),
+  party: () => partyMarkers(),
+  renown: () => ({ level: renownNow, xp: renownXp, pending: renownTracker?.pending?.() ?? 0 }),
+  overworldUp: () => travelView?.state === 'up' || travelView?.state === 'rising',
+  overworld: () => { if (townTalk.overlayActive) return false; travelViewKey(); return true; },
+  journey: (x, y, o = {}) => {
+    if (townTalk.overlayActive) return 'busy';
+    if (!tvRoutesJourneys()) return toggleTravelMap(o.site ?? null) ? 'map' : 'refused';
+    const why = travelViewAllowed();
+    if (!why.ok) { if (why.why) tvSay(why.why); return 'refused'; }
+    if (!travelViewCanGo()) return 'refused';
+    if (!o.spot) { const s = tvPlaceSummary(x, y, false); return s && travelViewRouteTo(s, { roads: tvMapForcesRoads() }) ? 'ok' : 'refused'; }
+    if (travelOptions?.settings?.targetCoordsAllowed === false) { tvSay(TRAVEL_VIEW_TEXT.placesOnly); return 'refused'; }
+    const w = mapPixelToWorldCoords(x, y), at = tvSceneOf(w.x + 16384, w.z + 16384, 0);
+    if (tvWater(x, y) || at[1] <= tvSeaY() + TV_SEA_EPS_M) { tvSay(TRAVEL_VIEW_TEXT.water); return 'refused'; }
+    return travelViewWalkTo(at, { x, y }, { roads: tvMapForcesRoads() }) ? 'ok' : 'refused';
+  },
 })).catch(() => {});`.replace(/\n\s*/g, ' ');
 
