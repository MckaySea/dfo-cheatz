   align-items: center; pointer-events: none; }
+.dfo-alerts.low, .dfo-alerts.low .dfo-alertcards { flex-direction: column-reverse; }
+.dfo-alertcards { display: flex; flex-direction: column; gap: 6px; align-items: center; }
+.dfo-alerthandle { display: none; height: 30px; align-items: center; gap: 8px; padding: 0 6px 0 12px; border-radius: 8px; white-space: nowrap;
+  background: var(--dfo-bg); border: 1px dashed var(--dfo-accent); color: var(--dfo-accent); font-weight: 600; cursor: move;
+  pointer-events: auto; user-select: none; touch-action: none; }
+.dfo-root.dfo-edit .dfo-alerthandle, .dfo-alerts.moving .dfo-alerthandle { display: flex; }
+.dfo-alerthandle button { all: unset; cursor: pointer; padding: 1px 6px; border-radius: 4px; color: var(--dfo-dim); }
+.dfo-alerthandle button:hover { color: var(--dfo-text); background: var(--dfo-bg2); }
+.dfo-alerthandle .done { display: none; }
+.dfo-alerts.moving .dfo-alerthandle .done { display: inline; color: var(--dfo-good); }
 .dfo-alert { min-width: 240px; max-width: 460px; padding: 7px 14px 8px; border-radius: 9px; background: var(--dfo-bg); border: 1px solid rgba(224,178,90,0.45);
